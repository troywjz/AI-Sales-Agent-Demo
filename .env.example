# Windows 演示模式：FastAPI 直接运行，继续使用 PostgreSQL，无需 Redis 或模型密钥。
APP_NAME=Sales Agent Demo
APP_ENV=demo
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET_KEY=windows-demo-secret-change-before-public-deployment
AUTH_TOKEN_TTL_SECONDS=43200
DEMO_MODE=true
DEMO_AGENT_DELAY_MS=60
DEMO_SEED_DATA=true
DEMO_ALLOW_UNSAFE_SEED=false

# 管理员演示账号。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_PASSWORD_HASH=

# Windows Python 通过本机映射端口连接 PostgreSQL。
# 建议为公开演示单独创建 sales_agent_demo 数据库。
DATABASE_URL=postgresql+psycopg://sales_agent:change-me@127.0.0.1:5432/sales_agent_demo

# 无密钥演示模型；如需接真实模型，可把 DEMO_MODE 改为 false 并填写下方配置。
LLM_PROVIDER=demo
LLM_PROVIDER_FALLBACK=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS_PER_REQUEST=0
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_MODELS=

# 对话、SOP 和本地案例 RAG。
CHAT_REQUEST_TIMEOUT_SECONDS=30
CHAT_MERGE_MAX_MESSAGES=3
CHAT_TURN_DEBOUNCE_SECONDS=0.15
AI_REPLY_CHUNK_DELAY_SECONDS=0.2
AI_REPLY_CHUNK_MAX_CHARS=45
KNOWLEDGE_AUTO_IMPORT=false
SOP_FOLLOWUP_ENABLED=true
SOP_FOLLOWUP_POLL_INTERVAL_SECONDS=2
SOP_FOLLOWUP_BATCH_SIZE=10
SALES_RAG_ENABLED=true
SALES_RAG_TOP_K=3
SALES_RAG_MIN_QUALITY_SCORE=0.45
SALES_RAG_MAX_REFERENCES=3
SALES_RAG_MAX_REFERENCE_CHARS=1200
NEW_CUSTOMER_WELCOME_MESSAGES="你好，我是你的专属方案顾问，很高兴认识你
你目前更想提升日常办公效率，还是解决某个具体工作场景？"
